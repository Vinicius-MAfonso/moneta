# ==========================================
# Core Settings
# ==========================================
DEBUG=False
SECRET_KEY=django-insecure-generate-a-strong-random-key-here
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://*.run.app,https://*.a.run.app,http://localhost:8000
SITE_URL=https://your-service-url.run.app

# ==========================================
# Database Connection (Neon / Supabase / Postgres)
# ==========================================
# Local SQLite default:
# DATABASE_URL=sqlite:///db.sqlite3
#
# Free Neon / Supabase / PostgreSQL (Production):
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/moneta_db?sslmode=require

# ==========================================
# Email Service (Brevo / Sendinblue - Free 300/day)
# ==========================================
BREVO_API_KEY=your_brevo_api_key_here
DEFAULT_FROM_EMAIL=Moneta <noreply@yourdomain.com>

# ==========================================
# WebPush Notifications (VAPID)
# ==========================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@yourdomain.com

# ==========================================
# Optional: Automatic Superuser Creation on Deploy
# ==========================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ChangeThisStrongPassword123!

# ==========================================
# Cloud Scheduler Cron Wake Endpoint
# ==========================================
# Secret token used to protect /internal/cron/wake/ from unauthorized access.
# Generate with: openssl rand -hex 32
# Also add as a GitHub Actions secret (CRON_SECRET) and set it in Cloud Scheduler's
# Authorization header: "Bearer <your-token>"
CRON_SECRET=